{
  "name": "work-accel-reader",
  "version": "0.1.0",
  "description": "透明置顶、可鼠标穿透的 TXT / EPUB 摸鱼阅读器",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node tools/make-icon.js",
    "dist": "node tools/make-icon.js && electron-builder --win portable zip"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "iconv-lite": "^0.6.3",
    "jschardet": "^3.1.4"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3"
  },
  "author": "MorniaOwO",
  "build": {
    "appId": "io.github.mornia-source.work-accel-reader",
    "productName": "WorkAccelReader",
    "copyright": "MorniaOwO",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable",
        "zip"
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "artifactName": "${productName}-${version}-win-${arch}.${ext}"
  }
}
